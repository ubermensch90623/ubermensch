+def _git_remote_hash(cwd: Path) -> str:
+    """Return a short stable hash of the repo's primary remote URL.
+
+    Prefers ``origin``; if no remote is configured, returns an empty
+    string so the caller can fall back to basename-only behavior. The
+    hash is sha1-truncated to ``_REMOTE_HASH_LEN`` chars — collision
+    risk is negligible for the user's local set of cloned repos.
+    """
+    try:
+        result = subprocess.run(  # noqa: S603, S607 — fixed argv, cwd is a Path.
+            ["git", "config", "--get", "remote.origin.url"],
+            cwd=cwd,
+            capture_output=True,
+            text=True,
+            check=False,
+            timeout=5,
+        )
+    except (FileNotFoundError, subprocess.TimeoutExpired) as exc:
+        _LOGGER.debug("git remote resolution failed: %s", exc)
+        return ""
+    if result.returncode != 0:
+        return ""
+    url = result.stdout.strip()
+    if not url:
+        return ""
+    return hashlib.sha1(url.encode("utf-8"), usedforsecurity=False).hexdigest()[
+        :_REMOTE_HASH_LEN
+    ]
