# scripts/quick-mcp-tunnel.sh가 읽는 환경변수.
# 이 파일을 .env로 복사한 뒤 값을 채운다. .env는 .gitignore에 등록되어 있다.

# Obsidian Local REST API 플러그인의 API 키 (필수).
# Obsidian → Settings → Community plugins → Local REST API → API Key 복사.
OBSIDIAN_API_KEY=

# Local REST API 플러그인이 리스닝하는 호스트와 포트 (기본값 사용 시 비워둬도 됨).
OBSIDIAN_HOST=127.0.0.1
OBSIDIAN_PORT=27124

# supergateway가 SSE를 노출할 로컬 포트. 다른 프로세스와 충돌 시 변경.
MCP_PORT=8765

# scripts/fetch-claude-ai.py가 사용. 비공식 경로.
# claude.ai 로그인 후 DevTools(F12) → Application/Storage → Cookies →
# https://claude.ai → "sessionKey" 값 복사. sk-ant-sid01-... 로 시작.
# 비밀번호와 같은 효력이 있으니 절대 커밋·공유 금지.
CLAUDE_AI_SESSION_KEY=
