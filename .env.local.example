# Anthropic Claude API
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-4-7

# Storage backend: "sqlite" (default, local file) | "vercel-kv"
STORAGE_BACKEND=sqlite

# SQLite path (only used when STORAGE_BACKEND=sqlite)
DATABASE_PATH=./data/atlas.db

# Vercel KV (only used when STORAGE_BACKEND=vercel-kv)
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
