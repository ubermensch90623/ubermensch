#!/usr/bin/env bash
# study-evolve wrapper — venv가 있으면 venv python을, 없으면 시스템 python3를 사용.
# PATH에 study-evolve/bin/을 추가하면 어디서든 `study-evolve add` 직접 호출 가능.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

if [ -x "$ROOT/.venv/bin/python" ]; then
    PY="$ROOT/.venv/bin/python"
elif command -v python3 >/dev/null 2>&1; then
    PY="python3"
else
    echo "Python을 찾을 수 없습니다. bin/install.sh 먼저 실행하세요." >&2
    exit 1
fi

exec "$PY" "$ROOT/main.py" "$@"
